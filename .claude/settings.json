{
  "permissions": {
    "allow": [
      "Bash(uv *)",
      "Bash(pnpm *)",
      "Bash(docker compose *)",
      "Bash(ffmpeg *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post_edit.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash -c 'cd \"$CLAUDE_PROJECT_DIR\"/apps/server && uv run pytest -q && cd ../web && pnpm tsc --noEmit'" }
        ]
      }
    ]
  }
}
